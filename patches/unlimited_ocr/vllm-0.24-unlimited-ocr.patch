+    @staticmethod
+    def verify_and_update_config(vllm_config: "VllmConfig") -> None:
+        # Ascend chooses its own attention and vision backends. CUDA backends in
+        # this 0.24 backport do not implement R-SWA masks.
+        from vllm.platforms import current_platform
+
+        # FL exposes vendor_name; native vLLM-Ascend identifies its NPU
+        # platform through the Ascend device-control contract instead.
+        vendor = getattr(current_platform, "vendor_name", None)
+        is_ascend = vendor == "ascend" or (
+            vendor is None
+            and getattr(current_platform, "device_control_env_var", None)
+            == "ASCEND_RT_VISIBLE_DEVICES"
+        )
+        if not (
+            current_platform.is_out_of_tree()
+            and current_platform.device_type == "npu"
+            and is_ascend
+        ):
+            raise ValueError("Unlimited-OCR 0.24 backport requires the Ascend R-SWA backend")
+        if vllm_config.cache_config.enable_prefix_caching:
+            vllm_config.cache_config.enable_prefix_caching = False
+            logger.info("Unlimited-OCR: disabling prefix caching for R-SWA")
+
+    @staticmethod
+    def verify_and_update_model_config(model_config: "ModelConfig") -> None:
+        text_config = model_config.hf_config.text_config
